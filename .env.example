# Variable names only. Never put values in this file or anywhere in the repo.
# Set them in the Vercel project's environment variables (deployed) or your own
# shell (local run).

# ---------------------------------------------------------------------------
# Billing (packages/cloud/src/billing/config.ts)
# ---------------------------------------------------------------------------

# Stripe secret or restricted key (sk_test_/rk_test_ while in test mode).
STRIPE_SECRET_KEY=
# "test" by default; "live" only after the manual test-mode check.
PROVENANT_BILLING_MODE=

# Stripe price ids. `provenant-cloud billing sync` prints which goes where.
# Cloud plan, monthly.
STRIPE_PRICE_CLOUD_MONTHLY=
# Cloud plan, annual.
STRIPE_PRICE_CLOUD_ANNUAL=
# Each extra identity on Cloud, monthly.
STRIPE_PRICE_CLOUD_EXTRA_IDENTITY=
# Pay-as-you-go evidence bundle, one-time.
STRIPE_PRICE_BUNDLE_PAYG=
# Overage bundle, metered monthly.
STRIPE_PRICE_BUNDLE_OVERAGE=

# ---------------------------------------------------------------------------
# Site (packages/site)
# ---------------------------------------------------------------------------

# Postgres connection string for the site's own database: the magic-link
# used-token table and the per-IP rate limits for sign-in and the contact form.
DATABASE_URL=
# HMAC key for sign-in link tokens and the session cookie. At least 32
# characters. Rotating it signs everyone out; it never changes an account id.
SESSION_SECRET=

# The email provider's HTTP send endpoint, its key and the address mail is sent
# from. These same three serve both senders: the sign-in link
# (src/auth/email.ts) and the Enterprise contact form and waitlist
# (app/api/contact/route.ts), which emails each submission to
# LEGAL.contactEmail. Whichever provider they point at must be the one named in
# src/legal.ts as emailProvider and contactProcessor, because the Privacy
# Policy lists it. While any of the three is unset the contact form says it
# cannot send and sends nothing.
#
# For Resend: https://api.resend.com/emails. Must be an https URL; anything
# else counts as unset. The key goes in the Authorization header, never a query
# string.
EMAIL_API_URL=
EMAIL_API_KEY=
# A verified sender at a domain the provider accepts.
EMAIL_FROM=
# "1" turns sign-in sending on. Anything else leaves it off; the contact form
# is not gated by this.
MAGIC_LINK_ENABLED=
# Origin for the links in sign-in emails, e.g. https://example.com. Used only
# when BRAND.domain is unset; the request's Host header is never consulted.
SITE_BASE_URL=
